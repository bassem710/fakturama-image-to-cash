  "nodes": [
    {
      "id": "extractor",
      "lane": "extract",
      "col": 0,
      "type": "backend",
      "label": "Image → JSON",
      "sublabel": "vision LLM + OCR",
      "tag": "Pydantic schema"
    },
    {
      "id": "validator",
      "lane": "extract",
      "col": 1,
      "type": "security",
      "label": "Validate math",
      "sublabel": "lines, VAT, totals",
      "tag": "Decimal"
    },
    {
      "id": "newDebtor",
      "lane": "master",
      "col": 2,
      "type": "database",
      "label": "New Debtor",
      "sublabel": "address, alias, payment"
    },
    {
      "id": "newProduct",
      "lane": "master",
      "col": 3,
      "type": "database",
      "label": "VAT then Product",
      "sublabel": "gross = net × (1+VAT)"
    },
    {
      "id": "openOrder",
      "lane": "order",
      "col": 1,
      "type": "frontend",
      "label": "Open New Order",
      "sublabel": "Date, Cust.Ref., Net"
    },
    {
      "id": "pickDebtor",
      "lane": "order",
      "col": 2,
      "type": "frontend",
      "label": "Select Debtor",
      "sublabel": "exact 5-field match"
    },
    {
      "id": "pickProducts",
      "lane": "order",
      "col": 3,
      "type": "frontend",
      "label": "Select Products",
      "sublabel": "exact SKU, each line",
      "tag": "qty, price, discount"
    },
    {
      "id": "saveOrder",
      "lane": "order",
      "col": 4,
      "type": "frontend",
      "label": "Save Order",
      "sublabel": "check Documents row"
    },
    {
      "id": "verify",
      "lane": "invoice",
      "col": 5,
      "type": "security",
      "label": "Verify records",
      "sublabel": "Invoice + open Order",
      "icon": "success"
    },
    {
      "id": "manual",
      "lane": "review",
      "col": 0,
      "type": "security",
      "label": "Stop for review",
      "sublabel": "log + screenshot",
      "icon": "stop"
    },
    {
      "id": "invoiceNode",
      "lane": "invoice",
      "col": 4,
      "type": "backend",
      "label": "Linked Invoice",
      "sublabel": "follow-up, paid if PAID"
    }
  ],
  "edges": [
    {
      "id": "e-validate",
      "from": "extractor",
      "to": "validator",
      "label": "JSON",
      "variant": "emphasis"
    },
    {
      "id": "e-open",
      "from": "validator",
      "to": "openOrder",
      "label": "valid",
      "variant": "emphasis"
    },
    {
      "id": "e-debtor",
      "from": "openOrder",
      "to": "pickDebtor"
    },
    {
      "id": "e-products",
      "from": "pickDebtor",
      "to": "pickProducts"
    },
    {
      "id": "e-save",
      "from": "pickProducts",
      "to": "saveOrder"
    },
    {
      "id": "e-missing-debtor",
      "from": "pickDebtor",
      "to": "newDebtor",
      "label": "no match",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "e-missing-product",
      "from": "pickProducts",
      "to": "newProduct",
      "label": "no SKU",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "e-bad-data",
      "from": "validator",
      "to": "manual",
      "label": "mismatch",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "e-invoice",
      "from": "saveOrder",
      "to": "invoiceNode",
      "label": "follow-up",
      "variant": "emphasis"
    },
    {
      "id": "e-verify",
      "from": "invoiceNode",
      "to": "verify",
      "label": "save"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Phase 0 · Before the clock (1–2 days)",
      "items": [
        "Install Fakturama and do the full flow by hand twice",
        "Map every control in Inspect.exe / Accessibility Insights",
        "Prototype one UIA script: open Order, set Cust.Ref."
      ]
    },
    {
      "dot": "violet",
      "title": "Part 1 · Design doc (90 min)",
      "items": [
        "Architecture + step contract (pre / act / verify / fail)",
        "Grounding ladder: UIA → keyboard → OCR in UIA rect",
        "Extraction + validation rules, matching rules, tradeoffs"
      ]
    },
    {
      "dot": "emerald",
      "title": "Part 2 · Build (5 h)",
      "items": [
        "0:00–0:45 repo, extraction schema, math validator + tests",
        "0:45–2:30 UIA helpers, Order, Debtor select/create",
        "2:30–4:00 Product + VAT, save Order, follow-up Invoice",
        "4:00–5:00 payment, verification, README, recording"
      ]
    },
    {
      "dot": "rose",
      "title": "Stop for manual review when",
      "items": [
        "Extracted totals do not add up",
        "Debtor, SKU, VAT or payment method is ambiguous",
        "Created record does not reappear in its selector",
        "Saved Documents row differs from the source"
      ]
    }
  ]
}