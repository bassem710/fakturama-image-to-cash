      "label": "Master data (create only if missing)"
    },
    {
      "id": "order",
      "label": "2–4 · Order editor (stays open)"
    },
    {
      "id": "invoice",
      "label": "5 · Linked Invoice and verify"
    },
    {
      "id": "review",
      "label": "Manual review",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "extractor",
    "validator",
    "openOrder",
    "pickDebtor",
    "pickProducts",
    "saveOrder",
    "invoiceNode",
    "verify"
